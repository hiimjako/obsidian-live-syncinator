{
    "$schema": "https://biomejs.dev/schemas/2.4.8/schema.json",
    "assist": { "actions": { "source": { "organizeImports": "on" } } },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "correctness": {
                "noUnusedImports": "warn",
                "noUnusedVariables": "warn"
            }
        }
    },
    "formatter": {
        "enabled": true,
        "formatWithErrors": false,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double"
        }
    },
    "files": {
        "includes": [
            "**/main.ts",
            "**/src/**/*.ts",
            "!**/node_modules",
            "!**/dist",
            "!**/build",
            "!**/main.js"
        ]
    }
}
